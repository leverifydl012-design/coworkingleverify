# Copy to `.env` for local dev. For production, set the same keys in your host's dashboard.
# VITE_* must be present at BUILD TIME on Cloudflare (they are baked into the client bundle).

# --- Client (browser) — safe to expose ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server (SSR + server functions) — never prefix with VITE_ ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin image uploads (server functions). Use a strong password in production.
ADMIN_PASSWORD=your-admin-password